# Server Settings
PORT=5000

# If a key was ever pasted into chat, email, or a screenshot, rotate it
# at the provider before use. Never commit real keys. This file is placeholders only.

# Gemini API Configurations
# Obtain key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Sarvam AI API Configurations (shared fallback for Odia STT and TTS)
# Obtain key from: https://sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here

# Dedicated Sarvam keys. When set, they override SARVAM_API_KEY for that capability.
SARVAM_TTS_API_KEY=your_sarvam_tts_api_key_here
SARVAM_STT_API_KEY=your_sarvam_stt_api_key_here

# Optional. Required only for PDF upload, RAG train, and full dataset dump
# when the request is not coming from this machine.
ADMIN_TOKEN=your_admin_token_here

# Database Settings (PostgreSQL / Supabase) — optional vector store
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/utkala_agents

# Extra browser origins allowed by CORS (the app itself is served by this server)
FRONTEND_URL=http://localhost:3000
