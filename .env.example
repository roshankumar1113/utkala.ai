# Server Settings
PORT=5000

# Gemini API Configurations
# Obtain key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Sarvam AI API Configurations (for Odia STT & TTS)
# Obtain key from: https://sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here

# Database Settings (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/utkala_agents

# Frontend URL (for Socket.io and CORS)
FRONTEND_URL=http://localhost:3000

